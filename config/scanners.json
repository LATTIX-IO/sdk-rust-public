{
  "_comment": "Declarative registry for the extended AppSec / threat-model / red-team suite. run_security_suite.py reads this; each scanner runs via docker (default) or a local binary, writes output into the scan run dir, and is parsed by normalize_findings.py per its declared 'format'. Scanners are skipped gracefully (not failed) when their required context/credentials/binary are absent. Placeholders like {image} are substituted from resolved context; mounted paths use fixed container paths (/src, /out, /model, /cfg).",
  "scanners": [
    {
      "id": "semgrep",
      "tier": 1,
      "phase": "shift-left",
      "category": "sast",
      "runner": "docker",
      "image": "semgrep/semgrep:latest",
      "args": ["semgrep", "scan", "--config", "auto", "--sarif", "--output", "/out/semgrep.sarif", "/src"],
      "mounts": [{"host": "source", "container": "/src", "mode": "ro"}, {"host": "out", "container": "/out"}],
      "requires": ["source"],
      "format": "sarif",
      "default_enabled": true,
      "notes": "Static analysis (OWASP Top 10, secrets, supply-chain rules) over source."
    },
    {
      "id": "trivy-fs",
      "tier": 1,
      "phase": "shift-left",
      "category": "sca",
      "runner": "docker",
      "image": "aquasec/trivy:latest",
      "args": ["fs", "--scanners", "vuln,secret,misconfig", "--format", "sarif", "--output", "/out/trivy-fs.sarif", "/src"],
      "mounts": [{"host": "source", "container": "/src", "mode": "ro"}, {"host": "out", "container": "/out"}],
      "requires": ["source"],
      "format": "sarif",
      "default_enabled": true,
      "notes": "Dependency vulns + secrets + IaC misconfig over the source tree."
    },
    {
      "id": "trivy-image",
      "tier": 1,
      "phase": "shift-left",
      "category": "container",
      "runner": "docker",
      "image": "aquasec/trivy:latest",
      "args": ["image", "--format", "sarif", "--output", "/out/trivy-image.sarif", "{image}"],
      "mounts": [{"host": "out", "container": "/out"}],
      "requires": ["image"],
      "format": "sarif",
      "default_enabled": true,
      "notes": "Container image vulnerability scan. Set PENTEST_IMAGE to the image ref."
    },
    {
      "id": "trufflehog",
      "tier": 1,
      "phase": "shift-left",
      "category": "secrets",
      "runner": "docker",
      "image": "trufflesecurity/trufflehog:latest",
      "args": ["filesystem", "/src", "--json", "--no-update"],
      "mounts": [{"host": "source", "container": "/src", "mode": "ro"}],
      "stdout_to": "trufflehog.json",
      "requires": ["source"],
      "format": "trufflehog",
      "default_enabled": true,
      "notes": "Secret detection with active credential verification (verified -> high)."
    },
    {
      "id": "checkov",
      "tier": 1,
      "phase": "shift-left",
      "category": "iac",
      "runner": "docker",
      "image": "bridgecrew/checkov:latest",
      "args": ["-d", "/src", "--compact", "-o", "sarif"],
      "mounts": [{"host": "source", "container": "/src", "mode": "ro"}],
      "stdout_to": "checkov.sarif",
      "requires": ["source"],
      "format": "sarif",
      "default_enabled": true,
      "allow_nonzero_exit": true,
      "notes": "IaC misconfig (Terraform, k8s, Helm, Dockerfile, ARM/Bicep)."
    },
    {
      "id": "grype",
      "tier": 3,
      "phase": "sbom",
      "category": "sca",
      "runner": "docker",
      "image": "anchore/grype:latest",
      "args": ["dir:/src", "-o", "sarif"],
      "mounts": [{"host": "source", "container": "/src", "mode": "ro"}],
      "stdout_to": "grype.sarif",
      "requires": ["source"],
      "format": "sarif",
      "default_enabled": true,
      "notes": "Dependency vulnerability scan (pairs with syft SBOM)."
    },
    {
      "id": "syft",
      "tier": 3,
      "phase": "sbom",
      "category": "sbom",
      "runner": "docker",
      "image": "anchore/syft:latest",
      "args": ["dir:/src", "-o", "spdx-json"],
      "mounts": [{"host": "source", "container": "/src", "mode": "ro"}],
      "stdout_to": "sbom.spdx.json",
      "requires": ["source"],
      "format": "artifact",
      "default_enabled": true,
      "notes": "SBOM generation (SPDX JSON) for supply-chain / compliance evidence."
    },
    {
      "id": "prowler-azure",
      "tier": 2,
      "phase": "cloud",
      "category": "cloud_misconfiguration",
      "runner": "docker",
      "image": "toniblyx/prowler:latest",
      "args": ["azure", "--output-formats", "json-ocsf", "--output-directory", "/out", "--output-filename", "prowler"],
      "mounts": [{"host": "out", "container": "/out"}],
      "env_passthrough": ["AZURE_CLIENT_ID", "AZURE_CLIENT_SECRET", "AZURE_TENANT_ID", "AZURE_SUBSCRIPTION_ID"],
      "requires_env": ["AZURE_CLIENT_ID", "AZURE_TENANT_ID"],
      "format": "prowler",
      "default_enabled": true,
      "allow_nonzero_exit": true,
      "notes": "Azure CSPM / CIS posture. Needs a service-principal credential."
    },
    {
      "id": "kube-bench",
      "tier": 2,
      "phase": "cluster",
      "category": "kubernetes_exposure",
      "runner": "docker",
      "image": "aquasec/kube-bench:latest",
      "args": ["--json"],
      "stdout_to": "kube-bench.json",
      "requires": [],
      "format": "kube-bench",
      "default_enabled": true,
      "allow_nonzero_exit": true,
      "notes": "CIS Kubernetes benchmark. Most accurate when run on a cluster node."
    },
    {
      "id": "kube-hunter",
      "tier": 2,
      "phase": "cluster",
      "category": "kubernetes_exposure",
      "runner": "docker",
      "image": "aquasec/kube-hunter:latest",
      "args": ["--report", "json", "--remote", "{k8s_target}"],
      "stdout_to": "kube-hunter.json",
      "network": "host",
      "requires": ["k8s_target"],
      "format": "kube-hunter",
      "default_enabled": true,
      "allow_nonzero_exit": true,
      "notes": "Kubernetes attack-surface enumeration. Set PENTEST_K8S_TARGET."
    },
    {
      "id": "promptfoo-redteam",
      "tier": 2,
      "phase": "llm",
      "category": "llm_security",
      "runner": "docker",
      "image": "node:20-alpine",
      "args": ["npx", "-y", "promptfoo@latest", "redteam", "run", "-c", "/cfg/redteam.yaml", "-o", "/out/promptfoo.json"],
      "mounts": [{"host": "llm_config", "container": "/cfg/redteam.yaml", "mode": "ro"}, {"host": "out", "container": "/out"}],
      "env_passthrough": ["ANTHROPIC_API_KEY", "OPENAI_API_KEY", "PENTEST_LLM_TARGET", "PENTEST_LLM_API_KEY"],
      "requires": ["llm_config"],
      "format": "promptfoo",
      "default_enabled": true,
      "allow_nonzero_exit": true,
      "notes": "LLM red-team (prompt injection, jailbreak, data leakage). Config: config/llm-redteam.promptfoo.yaml."
    },
    {
      "id": "garak",
      "tier": 2,
      "phase": "llm",
      "category": "llm_security",
      "runner": "local",
      "cmd": "garak",
      "args": ["--model_type", "{garak_model_type}", "--model_name", "{garak_model_name}", "--report_prefix", "{out}/garak"],
      "requires": ["garak_model_type", "garak_model_name"],
      "format": "garak",
      "default_enabled": false,
      "allow_nonzero_exit": true,
      "notes": "NVIDIA garak LLM scanner. Local install: pip install garak. Default off; opt in via PENTEST_GARAK_MODEL_TYPE/NAME."
    },
    {
      "id": "schemathesis",
      "tier": 3,
      "phase": "api",
      "category": "api_surface",
      "runner": "docker",
      "image": "schemathesis/schemathesis:stable",
      "args": ["run", "{openapi_url}", "--checks", "all", "--junit-xml", "/out/schemathesis.junit.xml"],
      "mounts": [{"host": "out", "container": "/out"}],
      "network": "host",
      "requires": ["openapi_url"],
      "format": "schemathesis",
      "default_enabled": true,
      "allow_nonzero_exit": true,
      "notes": "Property-based API fuzzing from an OpenAPI/GraphQL schema. Set PENTEST_OPENAPI_URL."
    },
    {
      "id": "threagile",
      "tier": 3,
      "phase": "threatmodel",
      "category": "threat_model",
      "runner": "docker",
      "image": "threagile/threagile:latest",
      "args": ["-model", "/model/threagile.yaml", "-output", "/out"],
      "mounts": [{"host": "threat_model", "container": "/model/threagile.yaml", "mode": "ro"}, {"host": "out", "container": "/out"}],
      "requires": ["threat_model"],
      "format": "threagile",
      "default_enabled": true,
      "allow_nonzero_exit": true,
      "notes": "Threat-model-as-code: STRIDE risk report from threatmodel/threagile-model.yaml."
    },
    {
      "id": "stratus",
      "tier": 2,
      "phase": "adversary",
      "category": "adversary_emulation",
      "runner": "docker",
      "image": "ghcr.io/datadog/stratus-red-team:latest",
      "args": ["detonate", "{stratus_technique}"],
      "env_passthrough": ["AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN", "AZURE_CLIENT_ID", "AZURE_CLIENT_SECRET", "AZURE_TENANT_ID", "AZURE_SUBSCRIPTION_ID"],
      "requires": ["stratus_technique"],
      "requires_env": ["PENTEST_ADVERSARY_ACK"],
      "safety": "destructive",
      "format": "none",
      "default_enabled": false,
      "allow_nonzero_exit": true,
      "notes": "DESTRUCTIVE: detonates a real ATT&CK technique in cloud to validate detections. Off by default. Requires PENTEST_ADVERSARY_ACK=I_UNDERSTAND and PENTEST_STRATUS_TECHNIQUE. Purple-team only, never against prod."
    },
    {
      "id": "atomic-red-team",
      "tier": 2,
      "phase": "adversary",
      "category": "adversary_emulation",
      "runner": "local",
      "cmd": "pwsh",
      "args": ["-Command", "Import-Module Invoke-AtomicRedTeam; Invoke-AtomicTest {atomic_technique} -GetPrereqs; Invoke-AtomicTest {atomic_technique}"],
      "requires": ["atomic_technique"],
      "requires_env": ["PENTEST_ADVERSARY_ACK"],
      "safety": "destructive",
      "format": "none",
      "default_enabled": false,
      "allow_nonzero_exit": true,
      "notes": "DESTRUCTIVE: executes an ATT&CK technique on the host to validate detections. Off by default. Requires Invoke-AtomicRedTeam installed, PENTEST_ADVERSARY_ACK=I_UNDERSTAND and PENTEST_ATOMIC_TECHNIQUE. Purple-team only, isolated hosts."
    }
  ]
}
